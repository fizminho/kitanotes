# Copy to .dev.vars for local Wrangler development. Never commit .dev.vars.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:8787

# Gemini API key from Google AI Studio. Keep the Google Cloud project unlinked from Cloud Billing.
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash
